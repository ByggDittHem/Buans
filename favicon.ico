
:root{--green:#48624f;--sand:#f5f2ea;--dark:#222}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--sand);color:var(--dark);line-height:1.6}
.hero{position:relative;min-height:88vh;background:url('../images/hero.webp') center/cover no-repeat;display:flex;align-items:center;justify-content:center}
.hero-overlay{background:rgba(20,25,20,.45);position:absolute;inset:0;color:#fff}
.hero-top{position:absolute;top:30px;left:40px}
.logo{height:72px;width:auto}
.hero-content{max-width:760px;text-align:center;margin:20vh auto 0;padding:0 20px}
.hero-content h1{font-size:clamp(2.5rem,6vw,4.6rem);margin:.2em 0}
.hero-size{font-size:1.4rem;margin-bottom:2rem}
.button{display:inline-block;background:#fff;color:#2d4736;padding:16px 34px;border-radius:999px;text-decoration:none;font-weight:700;transition:.2s}
.button:hover{transform:translateY(-2px)}
.hero-caption{position:absolute;bottom:20px;right:25px;font-size:.85rem;opacity:.9}
.container{max-width:1200px;margin:auto;padding:70px 24px}
.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:28px}
.info-card{background:#fff;border-radius:20px;padding:28px;box-shadow:0 10px 30px rgba(0,0,0,.08)}
.info-list{list-style:none;padding:0;margin:0}
.info-list li{display:grid;grid-template-columns:34px 1fr auto;gap:12px;padding:14px 0;border-bottom:1px solid #eee;align-items:center}
.info-list li:last-child{border-bottom:none}
.info-list i{font-size:1.4rem;color:var(--green)}
.contact{background:#fff}
.contact-logo{height:64px}
.footer{text-align:center;padding:25px}
@media(max-width:700px){.hero-top{left:20px;top:20px}.logo{height:58px}.hero-content{margin-top:18vh}.info-list li{grid-template-columns:30px 1fr}}
